# Раздача собранного интерфейса.
#
# /api/v1 и /socket.io сюда не доходят: их перехватывает traefik своими
# роутерами и отправляет в бэкенд задач. Здесь остаётся статика и прокси
# на авторизацию.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # За traefik: реальный адрес клиента приходит в заголовке.
    real_ip_header X-Forwarded-For;
    set_real_ip_from 0.0.0.0/0;

    # Авторизация живёт в auth-service на соседнем домене. Проксируем её
    # через себя, чтобы браузер остался на одном origin: иначе форма входа
    # упёрлась бы в CORS, а токен пришлось бы гонять между доменами.
    location /api/v2/auth/ {
        # Адрес задан переменной намеренно: без неё nginx резолвит upstream
        # при старте и падает, если auth-service ещё не поднялся. С
        # переменной резолв откладывается до запроса, и порядок запуска
        # контейнеров перестаёт иметь значение.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $auth_upstream "${AUTH_HOST}";

        proxy_pass http://$auth_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # SPA: любой неизвестный путь отдаёт index.html, маршрутизация
    # разбирается на клиенте.
    #
    # Файлы без хэша в имени (favicon.svg, icons.svg и прочее из public/)
    # обновляются на месте, поэтому надолго их кэшировать нельзя: имя
    # прежнее, а содержимое новое, и браузер не узнает о подмене.
    # Короткое время с обязательной перепроверкой — компромисс между
    # лишними запросами и застрявшей иконкой.
    location / {
        add_header Cache-Control "public, max-age=300, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }

    # Бандлы содержат хэш в имени, поэтому кэшируются надолго.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # index.html не кэшируется: иначе после деплоя браузер продолжит
    # грузить старые бандлы, которых уже нет.
    #
    # always обязателен: без него add_header молчит на ответах с кодом
    # вроде 304, и браузер, переспросивший по ETag, остаётся без
    # запрета кэширования.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    # API и сокет сюда не доходят (их забирает traefik), но если схема
    # раздачи изменится — запрет кэша должен уехать вместе с ней.
    location /api/ {
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
        return 404;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
