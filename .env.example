# Адрес бэкенда RTM-Task, на который dev-сервер проксирует /api/v1 и /socket.io
VITE_BACKEND_ORIGIN=http://localhost:8091

# Адрес auth-service платформы.
# Задан — dev-сервер работает как Traefik: валидирует Bearer-токен через
# token-validate и подставляет полученные X-User-* в запрос. Форма входа
# при этом обращается к реальному сервису.
VITE_AUTH_ORIGIN=http://localhost:8000

# --- Работа без auth-service ---
# Если VITE_AUTH_ORIGIN пуст, dev-сервер подставляет эти заголовки
# напрямую, без валидации. Форма входа в таком режиме не нужна —
# приложение сразу считает вас этим пользователем.
# VITE_DEV_USER_ID=2
# VITE_DEV_USER_NAME=Мира Соколова
# VITE_DEV_USER_ADMIN=true

# Базовый путь ручек авторизации (по умолчанию /api/v2/auth через прокси)
# VITE_AUTH_URL=/api/v2/auth

# Базовый путь REST API задач
# VITE_API_URL=/api/v1

# Origin сокета. Пустой — тот же хост, что и страница (через прокси).
# VITE_SOCKET_URL=
