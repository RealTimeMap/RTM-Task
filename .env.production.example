# Настройки развёртывания интерфейса.
#
# Файл лежит на сервере рядом с docker-compose.yml как .env — его читает
# сам compose, подставляя значения в образ и traefik-labels.
#
#   cp .env.production.example .env
#   docker compose up -d
#
# Переменных VITE_* здесь нет намеренно: в проде фронтенд — это статика,
# собранная Vite, и dev-сервера не существует. Адреса API зашиты в бандл
# относительными (/api/v1, /socket.io, /api/v2/auth), потому что интерфейс
# и API живут на одном домене — traefik разводит их по путям.

# Версия образа: latest, номер релиза (v1.2.0) или короткий SHA коммита.
# Собирается и публикуется через GitHub Actions в ghcr.io/realtimemap/rtm-task
TAG=latest

# Домен интерфейса. Должен входить в TLS-сертификат traefik.
APP_DOMAIN=task.realtimemap.ru

# Адрес auth-service, куда nginx проксирует /api/v2/auth.
# Прокси нужен, чтобы форма входа обращалась к своему origin:
# иначе браузер ушёл бы на соседний домен и упёрся в CORS.
AUTH_HOST=realtime-map-backend:8001
